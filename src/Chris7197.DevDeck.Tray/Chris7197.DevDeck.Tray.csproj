<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>chris7197.DevDeck.Tray</AssemblyName>
    <ApplicationIcon>Assets\devdeck.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="LogViewerForm.Designer.cs">
      <DependentUpon>LogViewerForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../chris7197.DevDeck.Core/chris7197.DevDeck.Core.csproj" />
    <EmbeddedResource Include="Assets\devdeck.ico" />
  </ItemGroup>
</Project>
